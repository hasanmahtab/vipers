# Copy this file to .env.local and change the values before deploying.

# Password for the very first admin account (username: admin).
# Only used the first time the database is created / seeded.
ADMIN_PASSWORD=change-me-please

# Long random string used to sign admin login sessions.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=change-this-to-a-long-random-string

# --- Database ---
# Production (recommended, and required on hosts with no persistent disk,
# like Render/Vercel free tiers): create a free database at https://turso.tech
# and paste its values here.
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token

# Local development only, used when the two variables above are not set —
# stores everything in a local file. This file is NOT persistent on hosts
# without a disk, so never rely on it in production.
DB_PATH=./data/vipers.db
